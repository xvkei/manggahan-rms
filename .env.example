# Copy this file to .env and change the values. Never commit your real .env file.

DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.app.github.dev
DJANGO_CSRF_TRUSTED_ORIGINS=https://*.app.github.dev

# Database: sqlite (default, no setup) or postgres
DB_ENGINE=sqlite
# DB_NAME=manggahan_rms
# DB_USER=postgres
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432

# Demo mode shows SMS codes on screen and simulates payments
RMS_DEMO_MODE=True
RMS_COMPLEX_NAME=Manggahan Sports Complex
RMS_COMPLEX_LOCATION=General Trias, Cavite
RMS_CONTACT_NUMBER=[CONTACT NUMBER]
